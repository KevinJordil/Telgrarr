# ============================================================================
#  Telgrarr — environment reference.  Copy to .env (git-ignored) and edit.
#
#  Resolution order (highest wins):
#    process environment (PM2 / systemd / Docker)  >  .env  >  data/config.json
#    >  built-in defaults.
#  The bundled .env loader never overrides a variable your process manager
#  already set, and a commented line below = use the default = unchanged behavior.
#
#  ONLY the variables below are environment-mapped. All integration settings
#  (Sonarr / Radarr / Emby / Telegram / TMDB base URLs, API keys, tokens, chat IDs)
#  live in data/config.json and are NOT environment variables.
# ============================================================================

# Node/Express runtime mode (framework convention, not a Telgrarr setting).
# Use 'production' for any real deployment.
NODE_ENV=production

# ---- Core (resolved in src/config.js) --------------------------------------

# Where all persistent state lives (queue, auth, sessions, config, ...).
# Default: <project-root>/data
# DATA_DIR=/srv/telgrarr/data

# Where rotating log files live (app.log, error.log, audit.log).
# Default: <project-root>/logs
# LOGS_DIR=/srv/telgrarr/logs

# Where backup archives (.zip) are written.
# Default: <project-root>/backups
# BACKUP_DIR=/srv/telgrarr/backups

# HTTP listen port.    Default: 3400   (else data/config.json listenerPort)
# PORT=3400

# HTTP listen address. Default: 0.0.0.0 (else data/config.json listenerHost)
# HOST=0.0.0.0

# Cross-origin allow-list for the API. Empty (default) => no CORS header =>
# same-origin only, which is correct when this process also serves the GUI.
# Set to exactly ONE origin (scheme + host + port) if the GUI is hosted separately.
# CORS_ORIGIN=https://telgrarr.example.com

# Express 'trust proxy'. Empty / false / 0 => OFF (default). Behind one reverse
# proxy or TLS terminator, set: true. Also accepts a hop count, IP, CIDR, or list.
# TRUST_PROXY=true

# ---- Security ---------------------------------------------------------------

# Shared secret authenticating Sonarr/Radarr webhooks. While unset, the webhook
# endpoints stay CLOSED (HTTP 401); set it, then update your *arr webhook URL.
# WEBHOOK_SECRET=

# Session-cookie 'Secure' flag. 'auto' (default) sets Secure on HTTPS requests
# (direct or via X-Forwarded-Proto); 'true' / 'false' force it on/off.
# COOKIE_SECURE=auto
# ---- Process management -----------------------------------------------------
# Lets the app trigger its own graceful restart after certain actions (e.g. a
# backup restore, or a settings/webhook-secret change that requires one).
# Detection is NOT automatically reliable across every deployment shape (FA-56
# / D-9): PM2 does not reliably inject PM2_HOME into a managed process's own
# environment, so auto-detecting "am I under PM2" cannot be trusted. SET THIS
# EXPLICITLY for your supervisor:
#   PM2                                     -> already set in ecosystem.config.example.js
#   systemd (Restart=always)                              -> RESTART_CAPABLE=1
#   Docker via the shipped docker-compose.yml              -> already set there
#                                                              by default; override
#                                                              HERE only to turn it
#                                                              off, or if you run a
#                                                              custom compose file
#                                                              with no restart policy
#   Docker, bare `docker run` with your own --restart flag -> RESTART_CAPABLE=1
#   bare `node src/index.js`, no supervisor              -> leave unset
# Left unset/false: the app still works correctly -- it just shows a
# "restart required" prompt in the GUI instead of restarting itself.
# RESTART_CAPABLE=1

